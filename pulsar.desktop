[Desktop Entry]
Type=Application
Version=1.0
Name=Pulsar
GenericName=Audio Routing
Comment=Graphical audio routing manager for PulseAudio and PipeWire
Exec=PLACEHOLDER_EXEC_PATH
Icon=pulsar
Terminal=false
Categories=AudioVideo;Audio;Settings;Mixer;
Keywords=sound;audio;volume;pulseaudio;pipewire;routing;loopback;mixer;streamer;
StartupNotify=true
X-KDE-SubstituteUID=false
X-KDE-StartupNotify=true

# install.sh rewrites PLACEHOLDER_EXEC_PATH with the launcher it installed.
# Distribution packages (deb, rpm, snap, flatpak, AppImage) ship a copy with
# Exec already set to the packaged binary and do not use this template.
